  "authored_intent": "Ranged spell attack within 30 feet for Poison dice; character-level cantrip scaling; no obsolete CON-save delivery.",
  "rules": [
    {
      "id": "r001",
      "text": "You spray toxic mist at a creature within range."
    },
    {
      "id": "r002",
      "text": "Make a ranged spell attack against the target."
    },
    {
      "id": "r003",
      "text": "On a hit, the target takes 1d12 Poison damage."
    },
    {
      "id": "r004",
      "text": "Cantrip Upgrade."
    },
    {
      "id": "r005",
      "text": "The damage increases by 1d12 when you reach levels 5 (2d12), 11 (3d12), and 17 (4d12)."
    }
