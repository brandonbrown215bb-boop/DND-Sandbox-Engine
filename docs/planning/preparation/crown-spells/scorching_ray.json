  "authored_intent": "Three Fire rays with separate ranged spell attacks and allocation; higher slots add ray; each hit is its own damage occurrence.",
  "rules": [
    {
      "id": "r001",
      "text": "You hurl three fiery rays."
    },
    {
      "id": "r002",
      "text": "You can hurl them at one target within range or at several."
    },
    {
      "id": "r003",
      "text": "Make a ranged spell attack for each ray."
    },
    {
      "id": "r004",
      "text": "On a hit, the target takes 2d6 Fire damage."
    },
    {
      "id": "r005",
      "text": "Using a Higher-Level Spell Slot."
    },
    {
      "id": "r006",
      "text": "You create one additional ray for each spell slot level above 2."
    }
  ],
