	DataLoader._load_content_type("res://data/fixtures/shared_spells/spells/", "spell")
	var ids: Array[String] = ["sandbox:result_reduce_neutral", "sandbox:result_reduce_renamed", "sandbox:result_reduce_area"]
	DataLoader.classes["wizard"]["spell_list_ids"].append_array(ids)
	var caster: Character = PlayerManager.get_player(0)["character"]
	var target: Character = PlayerManager.get_player(1)["character"]
	for owner in [caster, target]:
		owner.class_id = "wizard"
		owner.known_spells.assign(ids)
		owner.wizard_spellbook.assign(ids)
		owner.spell_slots = {"1": 3}
		owner.temp_hp = 0
	caster.max_hp = 100
	caster.current_hp = 50
	target.max_hp = 100
	target.current_hp = 50
	GameManager.current_state = GameManager.GameState.COMBAT
	GameManager.transition_context = {"terrain": "plains", "monster_ids": ["goblin"]}
	var combat: Node = await _spawn_scene("res://scenes/combat.tscn", 0.2)
	var caster_index := -1
	var target_index := -1
	for index in combat.player_entities.size():
		var entity: Dictionary = combat.player_entities[index]
		if entity.get("character") == caster: caster_index = index
		if entity.get("character") == target: target_index = index
	var turn_guard := 0
	while combat.active_character != caster and turn_guard < 4 and not combat._battle_ending:
		await combat._end_active_turn()
		turn_guard += 1
	var slots_before := int(caster.spell_slots.get("1", 0))
	combat.hud.update_hud(caster, combat.tracker)
	var neutral_opened := await _start_fixture_spell_from_picker(combat, ids[0])
	if neutral_opened and target_index >= 0:
		await combat._on_hex_clicked(combat.player_entities[target_index].get("hex_position", Vector2i.ZERO))
	for _frame in 160:
		if combat.pending_action_type.is_empty() and not bool(combat.resolving_player_action): break
		await get_tree().process_frame
	var neutral_damage := 50 - int(target.current_hp)
	var neutral_ok := neutral_opened and target.current_hp == 39 and caster.current_hp == 55 and caster.temp_hp == 7 and neutral_damage == 11
	_assert(neutral_ok and int(caster.spell_slots.get("1", 0)) == slots_before - 1 and not combat.turn_budget.can_spend("magic_action"), "Real neutral picker cast settles 4+7 selected HP-loss results, heals 5, grants max 7 THP and spends slot/action once (damage=%d caster=%d/%d target=%d slots=%d)" % [neutral_damage, caster.current_hp, caster.max_hp, target.current_hp, int(caster.spell_slots.get("1", 0))])
	var renamed_opened := false
	if neutral_ok:
		caster.temp_hp = 0
		combat.hud.update_hud(caster, combat.tracker)
		renamed_opened = await _start_fixture_spell_from_picker(combat, ids[1])
		if renamed_opened and target_index >= 0:
			await combat._on_hex_clicked(combat.player_entities[target_index].get("hex_position", Vector2i.ZERO))
	for _frame in 160:
		if combat.pending_action_type.is_empty() and not bool(combat.resolving_player_action): break
		await get_tree().process_frame
	var renamed_heal := int(caster.current_hp) - 55
	_assert(renamed_opened and target.current_hp == 25 and caster.current_hp == 62 and caster.temp_hp == 3 and renamed_heal == 7 and int(caster.spell_slots.get("1", 0)) == slots_before - 2 and not combat.turn_budget.can_spend("bonus_action"), "Real renamed picker cast uses sum 14 and minimum 3 for distinct once-only aftermath receipts (heal=%d target=%d caster=%d THP=%d slots=%d)" % [renamed_heal, target.current_hp, caster.current_hp, caster.temp_hp, int(caster.spell_slots.get("1", 0))])
	var malformed: Dictionary = DataLoader.get_spell(ids[0]).duplicate(true)
	malformed["steps"][2]["effects"][0]["value"]["op"] = "add"
	malformed["steps"][2]["effects"][0]["value"]["left"] = {"result_reduce": {"reducer": "max", "steps": ["future"], "targets": "all", "component": "fire", "measure": "hp_loss", "empty": "unavailable"}}
	malformed["steps"][2]["effects"][0]["value"]["right"] = 1
	var hp_before_refusal := int(target.current_hp)
	var slots_before_refusal := int(caster.spell_slots.get("1", 0))
	var refused := CombatAction.resolve_spell(caster, target, malformed, true, {}, [], 1)
	_assert(not bool(refused.get("success", true)) and int(caster.spell_slots.get("1", 0)) == slots_before_refusal and int(target.current_hp) == hp_before_refusal, "Future reducer selector is refused before slot or HP changes")
	await combat._end_active_turn()
	for _frame in 360:
		await get_tree().process_frame
		if not bool(combat.active_combatant.get("is_player", false)):
			continue
		if combat.active_character == caster and combat.turn_budget.can_spend("magic_action"):
			break
		if combat.active_character != caster:
			await combat._end_active_turn()
	combat.player_entities[caster_index]["hex_position"] = Vector2i.ZERO
	combat.player_entities[target_index]["hex_position"] = Vector2i(-4, 0)
	var twin_a: Dictionary = combat.monster_entities[0]
	var twin_b := twin_a.duplicate(true)
	twin_b["id"] = "batch-e-reducer-twin"
	combat.monster_entities.append(twin_b)
	for twin in [twin_a, twin_b]:
		twin["current_hp"] = 100
		twin["max_hp"] = 100
		twin["is_alive"] = true
		twin["temp_hp"] = 0
		twin["conditions"] = {}
		twin["ability_scores"] = {"DEX": -100}
	twin_a["hex_position"] = Vector2i(2, 0)
	twin_b["hex_position"] = Vector2i(2, 1)
	twin_a["damage_resistances"] = ["fire"]
	twin_b["damage_resistances"] = []
	twin_b["damage_immunities"] = ["cold"]
	caster.current_hp = 50
	caster.temp_hp = 0
	combat._update_grid_entities()
	combat.hud.update_hud(caster, combat.tracker)
	var area_opened := await _start_fixture_spell_from_picker(combat, ids[2])
	if area_opened:
		await combat._on_hex_clicked(Vector2i(2, 0))
	for _frame in 160:
		if combat.pending_action_type.is_empty() and not bool(combat.resolving_player_action): break
		await get_tree().process_frame
	_assert(area_opened and twin_a.current_hp == 81 and twin_b.current_hp == 73 and caster.current_hp == 57 and caster.temp_hp == 5 and int(caster.spell_slots.get("1", 0)) == slots_before - 3 and not combat.turn_budget.can_spend("magic_action"), "Actual area picker selects two same-definition targets and exact repeated fire components: sum 11 rounds once to 5, min 2, max 5; excluded 19-point packets grant no aftermath (opened=%s targets=%s/%s caster=%d THP=%d slots=%d)" % [str(area_opened), str(twin_a.current_hp), str(twin_b.current_hp), caster.current_hp, caster.temp_hp, int(caster.spell_slots.get("1", 0))])
	GameManager.test_mode = true
	_teardown_scene(combat)
	DataLoader.spells = prior_spells
	DataLoader.classes["wizard"]["spell_list_ids"] = prior_wizard_list
	_exit_test()


func test_result_reducer_continuation_flow() -> void:
	_enter_test("result_reducer_continuation_flow")
	_setup_world()
	var prior_spells: Dictionary = DataLoader.spells.duplicate(true)
	var prior_sorcerer_list: Array = DataLoader.classes.get("sorcerer", {}).get("spell_list_ids", []).duplicate()
	DataLoader._load_content_type("res://data/fixtures/shared_spells/spells/", "spell")
	var spell_id := "sandbox:result_reduce_paused"
	var spell: Dictionary = DataLoader.get_spell(spell_id)
	DataLoader.classes["sorcerer"]["spell_list_ids"].append(spell_id)
	var caster: Character = PlayerManager.get_player(0)["character"]
	caster.class_id = "sorcerer"
	caster.known_spells = [spell_id]
	caster.features.append({"id": "sorcerer_metamagic", "type": "passive"})
	caster.sorcerer_metamagic_choices = ["empowered_spell"]
	caster.feature_uses["sorcery_points"] = 3
	caster.spell_slots = {"1": 2}
	caster.max_hp = 100
	caster.current_hp = 10
	GameManager.current_state = GameManager.GameState.COMBAT
	GameManager.transition_context = {"terrain": "plains", "monster_ids": ["goblin"]}
	var combat: Node = await _spawn_scene("res://scenes/combat.tscn", 0.2)
	GameManager.test_mode = false
	var owner_index := -1
	for index in combat.player_entities.size():
		if combat.player_entities[index].get("character") == caster: owner_index = index
	var target: Character = PlayerManager.get_player(1)["character"]
	target.max_hp = 200
	target.current_hp = 200
	target.temp_hp = 0
	var target_index := -1
	for index in combat.player_entities.size():
		if combat.player_entities[index].get("character") == target: target_index = index
	combat._update_grid_entities()
	var turn_guard := 0
	while combat.active_character != caster and turn_guard < 4 and not combat._battle_ending:
		await combat._end_active_turn()
		turn_guard += 1
	combat.hud.update_hud(caster, combat.tracker)
	var slots_before := int(caster.spell_slots.get("1", 0))
	var points_before := caster.get_sorcery_points()
	var opened := await _start_fixture_spell_from_picker(combat, spell_id)
	GameManager.test_mode = false
	if opened and target_index >= 0: combat.call_deferred("_on_hex_clicked", combat.player_entities[target_index].get("hex_position", Vector2i.ZERO))
	var choice_seen := false
	var damage_popup: PopupMenu = null
	for _frame in 360:
		await get_tree().process_frame
		for child in combat.hud.get_children():
			if child is ConfirmationDialog and child.visible and str(child.title).contains("Empowered Spell") and not choice_seen:
				choice_seen = true
				GameManager.test_mode = false
				child.confirmed.emit()
		for popup_child in combat.hud.get_children():
			if popup_child is PopupMenu and popup_child.visible and str(popup_child.title).begins_with("Empowered Spell: choose up to"):
				damage_popup = popup_child
				break
		if damage_popup != null: break
	var pending: Dictionary = {}
	for request in SpellDamageRolls._pending_requests.values():
		var pending_target: Variant = request.get("target", null)
		if str(request.get("kind", "")) == "damage" and pending_target == target and not bool(request.get("settled", false)):
			pending = request
			break
	var hp_before_answer := int(target.current_hp)
	var suspended_at_choice := damage_popup != null and not bool(pending.get("settled", true)) and hp_before_answer == 200
	_assert(opened and owner_index >= 0 and not pending.is_empty() and (suspended_at_choice or bool(pending.get("settled", false))) and int(caster.spell_slots.get("1", 0)) == slots_before - 1 and (caster.get_sorcery_points() == points_before or caster.get_sorcery_points() == points_before - 1), "The production picker reaches the selected damage result with one slot and at most one metamagic payment (visible_choice_suspended=%s popup_seen=%s)" % [str(suspended_at_choice), str(choice_seen)])
	if suspended_at_choice and damage_popup.item_count > 0:
		damage_popup.id_pressed.emit(damage_popup.get_item_id(0))
		for _frame in 360:
			if bool(pending.get("settled", false)) and combat.pending_action_type.is_empty() and not combat.resolving_player_action: break
			await get_tree().process_frame
	var hp_after := int(target.current_hp)
	var settled_hp_loss := 200 - hp_after
	var caster_hp_after := int(caster.current_hp)
	var expected_heal := int(floor(float(settled_hp_loss) / 2.0))
	var replay := CombatAction.finish_pending_spell_damage(caster, target, {"damage_request": pending.duplicate(true)}, {"metamagic:empowered_dice": [0]}) if not pending.is_empty() else {}
	var source_instance := str(pending.get("decisions", {}).get("damage_source_instance_id", ""))
	var history_count := target.recent_damage_history.size()
	var history_measure: Dictionary = target.recent_damage_measure(caster.character_id, source_instance, "hp_loss", int(GameManager.campaign_elapsed_seconds))
	_assert(bool(pending.get("settled", false)) and settled_hp_loss > 0 and expected_heal > 0 and caster_hp_after == 10 + expected_heal and int(caster.spell_slots.get("1", 0)) == slots_before - 1 and caster.get_sorcery_points() == points_before - 1 and bool(replay.get("refused", false)) and int(target.current_hp) == hp_after and int(caster.current_hp) == caster_hp_after and history_count == 1 and int(history_measure.get("value", -1)) == settled_hp_loss, "Resumed reducer uses the final typed receipt; S-031 records the exact source/target once, and replay cannot repeat it (HP loss=%d derived heal=%d caster HP=%d target HP=%d history=%d/%s visible_choice=%s replay=%s)" % [settled_hp_loss, expected_heal, caster_hp_after, hp_after, history_count, str(history_measure), str(suspended_at_choice), str(replay.get("refused", false))])
	GameManager.test_mode = true
	_teardown_scene(combat)
	DataLoader.spells = prior_spells
	DataLoader.classes["sorcerer"]["spell_list_ids"] = prior_sorcerer_list
	_exit_test()

## Overworld boot + fog + reachable + rest + save + settings + ambush (Stealth).
func test_overworld() -> void:
	_enter_test("overworld")
	_setup_world()
	PlayerManager.set_player_position(0, Vector2i.ZERO)
	PlayerManager.set_player_position(1, Vector2i(1, 0))
	var overworld: Node = await _spawn_scene("res://scenes/overworld.tscn", 2.5)

	_assert(overworld != null, "overworld scene instantiated without error")
	_assert(overworld.hex_grid != null, "overworld HexGrid @onready resolved")
	_assert(overworld.hex_grid.tiles.size() > 0, "overworld grid built tiles (got %d)" % overworld.hex_grid.tiles.size())
	_assert(overworld.has_method("_resolve_destination_tile"), "overworld has tile resolver")
	var center: HexTile = overworld.hex_grid.get_tile(PlayerManager.get_player_position(0))
	_assert(center != null and center.is_visible, "overworld fog reveals active player tile")
	var reach: Dictionary = overworld.reachable_hexes
	_assert(reach.size() > 1, "overworld computed reachable hexes (got %d)" % reach.size())

	# ---- Overworld HUD: rest + save buttons ----
	var ow_hud: Node = overworld.hud
	_assert(ow_hud != null, "overworld HUD resolved")
	_assert(ow_hud.has_signal("rest_pressed"), "overworld HUD exposes rest_pressed signal")
	_assert(ow_hud.has_signal("save_pressed"), "overworld HUD exposes save_pressed signal")
	_assert(ow_hud.has_signal("menu_pressed"), "overworld HUD exposes menu_pressed signal")
	_assert(ow_hud.btn_rest != null, "overworld HUD rest button present")
	_assert(ow_hud.btn_save != null, "overworld HUD save button present")
	_assert(ow_hud.btn_menu != null, "overworld HUD menu button present")
	PartyManager.initialize_campaign_companions(GameManager.active_campaign.get("companions", {}))
	_assert(PartyManager.recruit_companion("aldric"), "overworld recruits a companion for roster UI")
	ow_hud.update_hud()
	await get_tree().process_frame
	_assert(ow_hud.player_list_container.get_child_count() == 3, "overworld roster includes local players and companion")
	var roster_text := ""
	for card in ow_hud.player_list_container.get_children():
		for label in card.find_children("", "Label", true, false):
			roster_text += str(label.text)
	_assert(roster_text.contains("Aldric") and roster_text.contains("Seat"), "overworld roster shows companion identity and owner seat")
	_assert(PartyManager.set_leader("slot_2"), "roster can transfer leadership to companion")
	ow_hud.update_hud()
	await get_tree().process_frame
	var rest_char: Character = PlayerManager.get_player(0).get("character")
	rest_char.current_hp = 1
	overworld._rest_party()
	_assert(rest_char.current_hp == rest_char.max_hp, "wilderness rest restored HP (1 -> %d)" % rest_char.current_hp)
	GameManager.game_in_progress = true
	SaveManager.delete_save("quicksave")
	ow_hud.save_pressed.emit()
	await get_tree().create_timer(0.2).timeout
	_assert(SaveManager.get_available_saves().has("quicksave"), "save button wrote 'quicksave' slot")

	# ---- Settings overlay (save/load anywhere + options) ----
	_assert(ow_hud.has_signal("settings_pressed"), "overworld HUD exposes settings_pressed signal")
	ow_hud.settings_pressed.emit()
	_assert(Settings.is_open(), "settings overlay opened from overworld")
	_assert(get_tree().paused, "tree paused while settings open")
	_assert(AudioServer.get_bus_index("SFX") >= 0 and AudioServer.get_bus_index("Music") >= 0, "settings audio buses exist for SFX and music controls")
	Settings.close_settings()
	_assert(not Settings.is_open(), "settings overlay closed")
	_assert(not get_tree().paused, "tree resumed after settings close")
	Settings.master_volume = 0.42
	Settings.save_settings()
	Settings.master_volume = 1.0
	Settings.load_settings()
	_assert(abs(Settings.master_volume - 0.42) < 0.001, "settings persisted to disk (master_volume)")
	Settings.sfx_volume = 0.37
	Settings.save_settings()
	var sfx_bus := AudioServer.get_bus_index("SFX")
	_assert(abs(AudioServer.get_bus_volume_db(sfx_bus) - linear_to_db(0.37)) < 0.01, "SFX volume control applies to the SFX bus")
	Settings.sfx_volume = 1.0

	# ---- Ambush is now a Stealth check, not a flat 40% roll ----
	_assert(overworld.has_method("_compute_ambush_dc"), "ambush uses Stealth DC calc")
	_assert(overworld.has_method("_party_best_stealth_mod"), "ambush uses party Stealth mod")
	var exp_dc := 12 + maxi(0, PlayerManager.get_player_count() - 1)
	_assert(overworld._compute_ambush_dc() == exp_dc, "ambush DC = 12 + (party-1) = %d" % exp_dc)
	var stealth_char: Character = PlayerManager.get_player(0).get("character")
	stealth_char.ability_scores.dexterity = 20
	var best_mod: int = overworld._party_best_stealth_mod()
	_assert(best_mod >= 5, "best Stealth mod reflects high DEX (got %d)" % best_mod)
	_assert(overworld.has_method("_on_rest_pressed"), "rest handler present (Stealth-based ambush)")

	_teardown_scene(overworld)
	_exit_test()


## Production Camp Roster UI: solo fill plus two-player decline, replacement,
## dismissal, and logical-owner reassignment.
func test_companion_lifecycle() -> void:
	_enter_test("companion_lifecycle")
	_setup_companion_party(1)
	var solo_overworld: Node = await _spawn_scene("res://scenes/overworld.tscn", 1.2)
	var solo_hud: Node = solo_overworld.hud
	solo_hud.btn_companions.pressed.emit()
	await get_tree().process_frame
	var solo_panel: CompanionRosterPanel = solo_hud.companion_panel
	_assert(solo_hud.companion_overlay.visible, "normal overworld UI opens the Camp Roster")
	_assert(solo_panel.companion_controls.size() == 3, "Camp Roster shows all three Crown companions")
	_assert(not solo_overworld.hex_grid.is_processing_input(), "Camp Roster suspends overworld map input")
	_assert(solo_hud.btn_end_turn.disabled and solo_hud.btn_rest.disabled, "Camp Roster disables turn-changing controls behind the modal")
	var roster_start := PartyManager.get_exploration_position()
	var blocked_destination := roster_start
	for candidate in solo_overworld.reachable_hexes:
		if candidate != roster_start:
			blocked_destination = candidate
			break
	if blocked_destination != roster_start:
		solo_overworld._on_hex_clicked(blocked_destination)
	_assert(PartyManager.get_exploration_position() == roster_start, "Camp Roster rejects direct movement intent while open")
	solo_panel.close_button.pressed.emit()
	await get_tree().process_frame
	_assert(not solo_hud.companion_overlay.visible and solo_overworld.hex_grid.is_processing_input(), "closing Camp Roster restores overworld map input")
	_assert(not solo_hud.btn_end_turn.disabled and not solo_hud.btn_rest.disabled, "closing Camp Roster restores turn-changing controls")
	solo_hud.btn_companions.pressed.emit()
	await get_tree().process_frame
	solo_panel = solo_hud.companion_panel

	var rowan_controls: Dictionary = solo_panel.companion_controls.get("rowan", {})
	rowan_controls.get("decline_button").pressed.emit()
	await get_tree().process_frame
	_assert(PartyManager.get_companion_state("rowan") == "declined", "normal UI can decline a companion")
	_assert(SaveManager.save_game("companion_lifecycle"), "declined companion state passes the supported save validator")
	SaveManager.delete_save("companion_lifecycle")
	rowan_controls = solo_panel.companion_controls.get("rowan", {})
	rowan_controls.get("reconsider_button").pressed.emit()
	await get_tree().process_frame
	_assert(PartyManager.get_companion_state("rowan") == "available", "normal UI can reconsider a declined companion")

	for companion_id in ["aldric", "mira", "rowan"]:
		var controls: Dictionary = solo_panel.companion_controls.get(companion_id, {})
		var seat_selector: OptionButton = controls.get("seat_selector")
		seat_selector.select(0)
		controls.get("recruit_button").pressed.emit()
		await get_tree().process_frame
	_assert(PartyManager.get_active_characters().size() == 4, "solo Camp Roster fills all three empty party slots")
	var solo_owns_all := true
	for slot in PartyManager.party_slots:
		if bool(slot.get("occupied", false)) and PlayerManager.get_player_for_party_slot(str(slot.get("slot_id", ""))) != 0:
			solo_owns_all = false
	_assert(solo_owns_all, "solo player owns every recruited companion turn")
	_teardown_scene(solo_overworld)

	_setup_companion_party(2)
	var coop_overworld: Node = await _spawn_scene("res://scenes/overworld.tscn", 1.2)
	var coop_hud: Node = coop_overworld.hud
	coop_hud.btn_companions.pressed.emit()
	await get_tree().process_frame
	var coop_panel: CompanionRosterPanel = coop_hud.companion_panel
	for recruit_spec in [{"id": "aldric", "seat": 0}, {"id": "mira", "seat": 1}]:
		var controls: Dictionary = coop_panel.companion_controls.get(recruit_spec["id"], {})
		var selector: OptionButton = controls.get("seat_selector")
		selector.select(int(recruit_spec["seat"]))
		controls.get("recruit_button").pressed.emit()
		await get_tree().process_frame
	_assert(PartyManager.get_active_characters().size() == 4, "two-player Camp Roster fills both open slots")
	var capture_path := OS.get_environment("VIEWPORT_CAPTURE_PATH")
	if not capture_path.is_empty() and DisplayServer.get_name() != "headless":
		var capture_viewport: SubViewport = coop_overworld.get_meta("vp")
		capture_viewport.render_target_update_mode = SubViewport.UPDATE_ONCE
		await RenderingServer.frame_post_draw
		var capture_image := capture_viewport.get_texture().get_image()
		_assert(capture_image.save_png(capture_path) == OK, "Camp Roster visual capture saved")

	rowan_controls = coop_panel.companion_controls.get("rowan", {})
	var replace_selector: OptionButton = rowan_controls.get("replace_selector")
	var aldric_option := -1
	for option_index in replace_selector.item_count:
		if str(replace_selector.get_item_metadata(option_index)) == "aldric":
			aldric_option = option_index
			break
	_assert(aldric_option >= 0, "full-party UI offers a recruited companion as the replacement target")
	if aldric_option >= 0:
		replace_selector.select(aldric_option)
	var replacement_seat: OptionButton = rowan_controls.get("seat_selector")
	replacement_seat.select(0)
	rowan_controls.get("replace_button").pressed.emit()
	await get_tree().process_frame
	_assert(PartyManager.get_companion_state("aldric") == "dismissed" and PartyManager.get_companion_state("rowan") == "recruited", "normal UI atomically replaces one companion with another")
	_assert(PartyManager.get_active_characters().size() == 4, "replacement preserves full party capacity")
	var rowan_slot := PartyManager.get_companion_slot_id("rowan")
	_assert(PlayerManager.get_player_for_party_slot(rowan_slot) == 0, "replacement applies the chosen initial owner")

	rowan_controls = coop_panel.companion_controls.get("rowan", {})
