        "id": "cleric_divine_order",
        "name": "Divine Order",
        "description": "Choose Protector or Thaumaturge. Protector grants Martial weapon proficiency and Heavy Armor training. Thaumaturge grants one additional Cleric cantrip and a Wisdom-based bonus on Arcana and Religion checks.",
        "type": "passive",
