{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shared spell",
  "description": "One ordinary spell record. Runtime SharedSpell.content_error also validates executable combinations, durations, gates and geometry.",
  "type": "object",
  "required": [
    "id",
    "name",
    "execution",
    "level",
    "range"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "execution": {
      "const": "shared"
    },
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "casting_time": {
      "enum": [
        "action",
        "bonus_action"
      ]
    },
    "range": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "range_kind": {
      "type": "string"
    },
    "range_by_character_level_feet": {},
    "target": {
      "enum": [
        "single",
        "self",
        "multi",
        "area",
        "cone"
      ]
    },
    "base_targets": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "attack_type": {
      "enum": [
        "none",
        "ranged_spell",
        "melee_spell"
      ]
    },
    "damage": {
      "$ref": "#/definitions/formula"
    },
    "damage_type": {
      "enum": [
        "acid",
        "bludgeoning",
        "cold",
        "fire",
        "force",
        "lightning",
        "necrotic",
        "piercing",
        "poison",
        "psychic",
        "radiant",
        "slashing",
        "thunder"
      ]
    },
    "scaling": {
      "type": "object",
      "patternProperties": {
        "^[0-9]+$": {
          "$ref": "#/definitions/formula"
        }
      },
      "additionalProperties": false
    },
    "upcast": {
      "type": "object",
      "properties": {
        "damage_per_level": {
          "type": "string",
          "pattern": "^[1-9][0-9]?d(4|6|8|10|12|20)$"
        },
        "healing_dice_per_level": {
          "type": "string",
          "pattern": "^[1-9][0-9]?d(4|6|8|10|12|20)$"
        },
        "starting_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "levels_per_increment": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "additional_targets_per_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "temporary_hp_per_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "healing_per_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "save": {
      "enum": [
        "STR",
        "DEX",
        "CON",
        "INT",
        "WIS",
        "CHA"
      ]
    },
    "half_on_save": {
      "type": "boolean"
    },
    "requires_target_sight": {
      "type": "boolean"
    },
    "target_creature_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_creature_type_exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_sizes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ignore_cover_on_save": {
      "type": "boolean"
    },
    "effects": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "enum": [
                  "heal",
                  "temporary_hp"
                ]
              },
              "on_spell_hit": {
                "type": "boolean"
              },
              "on_failed_save": {
                "type": "boolean"
              },
              "value": {
                "$ref": "#/definitions/formula"
              },
              "ability_bonus_from_caster": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "condition"
            ],
            "properties": {
              "type": {
                "enum": [
                  "grant_condition",
                  "remove_condition"
                ]
              },
              "on_spell_hit": {
                "type": "boolean"
              },
              "on_failed_save": {
                "type": "boolean"
              },
              "condition": {
                "enum": [
                  "blinded",
                  "deafened",
                  "frightened",
                  "poisoned",
                  "prone",
                  "restrained",
                  "stunned",
                  "paralyzed",
                  "incapacitated",
                  "blessed",
                  "baned",
                  "shield_of_faith"
                ]
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "shape"
            ],
            "properties": {
              "type": {
                "enum": [
                  "area_selection"
                ]
              },
              "on_spell_hit": {
                "type": "boolean"
              },
              "on_failed_save": {
                "type": "boolean"
              },
              "shape": {
                "enum": [
                  "sphere",
                  "cone",
                  "cube"
                ]
              },
              "radius": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "concentration": {
      "type": "boolean"
    },
    "duration": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "repeat_save": {
      "enum": [
        "STR",
        "DEX",
        "CON",
        "INT",
        "WIS",
        "CHA"
      ]
    },
    "targets_objects": {
      "type": "boolean"
    },
    "ignites_objects": {
      "type": "boolean"
    },
    "area_radius": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "cone_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "end_on_target_damage": {
      "type": "boolean"
    },
    "end_on_any_damage": {
      "type": "boolean"
    },
    "end_on_party_damage": {
      "type": "boolean"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "material": {
      "type": "string"
    },
    "material_component_item_id": {
      "type": "string"
    },
    "material_component_cost": {},
    "material_component_consumed": {
      "type": "boolean"
    },
    "consumed_material_item_id": {
      "type": "string"
    },
    "ritual": {
      "type": "boolean"
    },
    "rules_source": {
      "type": "string"
    },
    "rules_status": {
      "type": "string"
    },
    "school": {
      "type": "string"
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "string"
    },
    "trigger": {
      "const": ""
    }
  },
  "patternProperties": {
    "^_": {}
  },
  "additionalProperties": false,
  "definitions": {
    "formula": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        {
          "type": "string",
          "pattern": "^([0-9]{1,3}|[1-9][0-9]?d(4|6|8|10|12|20))([+][0-9]{1,3})?$"
        }
      ]
    }
  }
}
