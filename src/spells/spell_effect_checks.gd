	sunburst_target["saving_throw_bonuses"]["CON"] = 1000
	sunburst_repeat = CombatAction.resolve_condition_spell_repeat_save(sunburst_target, sunburst_source)
	check.call(sunburst_repeat.get("saved", false) and not SpellEffects.has_spell(sunburst_target, "sunburst") and not CombatAction.has_condition(sunburst_target, "blinded"), "A successful Sunburst repeat save removes only that spell's Blinded source")
	var sunburst_expiring_target := {"id": "sunburst-expiring-target", "name": "Sunburst expiring target", "is_alive": true, "current_hp": 500, "max_hp": 500, "armor_class": 10, "creature_type": "humanoid", "conditions": {}, "condition_sources": {}, "spell_effects": {}, "saving_throw_bonuses": {"CON": -100}}
	var expiring_sunburst_cast := SpellEffects.begin_cast(first, DataLoader.get_spell("sunburst"))
	SpellEffects.grant(sunburst_expiring_target, expiring_sunburst_cast, "blinded")
	for turn_end in range(10):
		CombatAction.resolve_condition_spell_repeat_save(sunburst_expiring_target, str(expiring_sunburst_cast["source_id"]))
	check.call(not SpellEffects.has_spell(sunburst_expiring_target, "sunburst") and not CombatAction.has_condition(sunburst_expiring_target, "blinded"), "A failed Sunburst repeat save expires after ten affected creature turns")
	var one := _hold(first, monster)
	var two := _hold(second, monster, "hold_person")
	var source_one := str(one["effect_cast"]["source_id"])
	var source_two := str(two["effect_cast"]["source_id"])
	check.call(CombatAction.is_paralyzed(monster) and SpellEffects.records(monster).size() == 2 and source_one != source_two, "Two casters own distinct overlapping Hold effects")
	first.ability_scores.set_score("INT", 20)
	check.call(int(SpellEffects.records(monster)[source_one]["save_dc"]) == int(one["save_dc"]), "Repeat-save DC is captured at casting")
	monster["saving_throw_bonuses"]["WIS"] = 1000
	var repeated := CombatAction.resolve_condition_spell_repeat_save(monster, source_one)
	check.call(repeated.get("saved", false) and not SpellEffects.records(monster).has(source_one) and CombatAction.is_paralyzed(monster) and SpellEffects.records(monster).has(source_two), "A successful repeat save removes only that cast")
	SpellEffects.reconcile([first, second], [monster])
	check.call(first.concentrating_on.is_empty() and not second.concentrating_on.is_empty(), "Only the caster with no remaining targets releases concentration")
	SpellEffects.end_concentration(second, [monster])
	check.call(not CombatAction.is_paralyzed(monster), "Ending concentration releases its remaining targets")
	var divine_favor_cast := SpellEffects.begin_cast(first, DataLoader.get_spell("divine_favor"))
	check.call(SpellEffects.grant_divine_favor(first, divine_favor_cast) and SpellEffects.has_spell(first, "divine_favor"), "Divine Favor records its timed weapon rider on the caster")
	SpellEffects.reconcile([first], [first])
	check.call(SpellEffects.has_spell(first, "divine_favor"), "Conditionless Divine Favor survives source reconciliation")
	SpellEffects.advance_time([first], 60)
	check.call(not SpellEffects.has_spell(first, "divine_favor"), "Divine Favor's source record expires after its one-minute duration")
	print("DIVINE_FAVOR_EFFECT_CHECKS_COMPLETE")
	var death_ward_target := _character("effects-death-ward")
	death_ward_target.current_hp = 5
	death_ward_target.temp_hp = 2
	var death_ward_cast := SpellEffects.begin_cast(first, DataLoader.get_spell("death_ward"))
	check.call(SpellEffects.grant_death_ward(death_ward_target, death_ward_cast), "Death Ward records an eight-hour source-owned protection")
	var ward_nonlethal := CombatAction.resolve_damage(death_ward_target, 1, "slashing")
	check.call(not bool(ward_nonlethal.get("death_ward_prevented", false)) and SpellEffects.has_spell(death_ward_target, "death_ward"), "Nonlethal damage preserves Death Ward")
	var ward_lethal := CombatAction.resolve_damage(death_ward_target, 20, "slashing")
	check.call(bool(ward_lethal.get("death_ward_prevented", false)) and death_ward_target.current_hp == 1 and death_ward_target.is_alive and death_ward_target.temp_hp == 0 and not SpellEffects.has_spell(death_ward_target, "death_ward"), "Death Ward absorbs a fatal hit through temporary HP and ends at 1 Hit Point")
	var expiring_ward := SpellEffects.begin_cast(first, DataLoader.get_spell("death_ward"))
	SpellEffects.grant_death_ward(death_ward_target, expiring_ward)
	SpellEffects.advance_time([first, death_ward_target], 28800)
	check.call(not SpellEffects.has_spell(death_ward_target, "death_ward"), "An unused Death Ward expires after eight hours")
	print("DEATH_WARD_EFFECT_CHECKS_COMPLETE")
	var sanctuary_caster := _character("effects-sanctuary-caster")
	sanctuary_caster.ability_scores.set_score("WIS", 30)
	var sanctuary_target := _character("effects-sanctuary-target")
