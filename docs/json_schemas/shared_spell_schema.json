{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shared spell",
  "description": "One ordinary spell record. Runtime SharedSpell.content_error also validates executable combinations, durations, gates and geometry.",
  "type": "object",
  "required": [
    "id",
    "name",
    "execution",
    "level",
    "range"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "execution": {
      "const": "shared"
    },
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "casting_time": {
      "enum": [
        "action",
        "bonus_action"
      ]
    },
    "range": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "range_kind": {
      "type": "string"
    },
    "range_by_character_level_feet": {},
    "target": {
      "enum": [
        "single",
        "self",
        "multi",
        "area",
        "cone"
      ]
    },
    "base_targets": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "attack_type": {
      "enum": [
        "none",
        "ranged_spell",
        "melee_spell"
      ]
    },
    "damage": {
      "$ref": "#/definitions/formula"
    },
    "damage_type": {
      "enum": [
        "acid",
        "bludgeoning",
        "cold",
        "fire",
        "force",
        "lightning",
        "necrotic",
        "piercing",
        "poison",
        "psychic",
        "radiant",
        "slashing",
        "thunder"
      ]
    },
    "scaling": {
      "type": "object",
      "patternProperties": {
        "^[0-9]+$": {
          "$ref": "#/definitions/formula"
        }
      },
      "additionalProperties": false
    },
    "upcast": {
      "type": "object",
      "properties": {
        "damage_per_level": {
          "type": "string",
          "pattern": "^[1-9][0-9]?d(4|6|8|10|12|20)$"
        },
        "healing_dice_per_level": {
          "type": "string",
          "pattern": "^[1-9][0-9]?d(4|6|8|10|12|20)$"
        },
        "starting_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "levels_per_increment": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "additional_targets_per_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "temporary_hp_per_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "healing_per_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "save": {
      "enum": [
        "STR",
        "DEX",
        "CON",
        "INT",
        "WIS",
        "CHA"
      ]
    },
    "half_on_save": {
      "type": "boolean"
    },
    "damage_scale_by_outcome": {
      "$ref": "#/definitions/damage_scale_by_outcome"
    },
    "requires_target_sight": {
      "type": "boolean"
    },
    "target_creature_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_creature_type_exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_sizes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ignore_cover_on_save": {
      "type": "boolean"
    },
    "effects": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "enum": [
                  "heal",
                  "temporary_hp"
                ]
              },
              "on_spell_hit": {
                "type": "boolean"
              },
              "on_failed_save": {
                "type": "boolean"
              },
              "rider_by_outcome": {
                "$ref": "#/definitions/rider_by_outcome"
              },
              "value": {
                "$ref": "#/definitions/formula"
              },
              "ability_bonus_from_caster": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "condition"
            ],
            "properties": {
              "type": {
                "enum": [
                  "grant_condition",
                  "remove_condition"
                ]
              },
              "on_spell_hit": {
                "type": "boolean"
              },
              "on_failed_save": {
                "type": "boolean"
              },
              "rider_by_outcome": {
                "$ref": "#/definitions/rider_by_outcome"
              },
              "condition": {
                "enum": [
                  "blinded",
                  "deafened",
                  "frightened",
                  "poisoned",
                  "prone",
                  "restrained",
                  "stunned",
                  "paralyzed",
                  "incapacitated",
                  "blessed",
                  "baned",
                  "shield_of_faith"
                ]
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "shape"
            ],
            "properties": {
              "type": {
                "enum": [
                  "area_selection"
                ]
              },
              "on_spell_hit": {
                "type": "boolean"
              },
              "on_failed_save": {
                "type": "boolean"
              },
              "rider_by_outcome": {
                "$ref": "#/definitions/rider_by_outcome"
              },
              "shape": {
                "enum": [
                  "sphere",
                  "cone",
                  "cube"
                ]
              },
              "radius": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "concentration": {
      "type": "boolean"
    },
    "duration": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "repeat_save": {
      "enum": [
        "STR",
        "DEX",
        "CON",
        "INT",
        "WIS",
        "CHA"
      ]
    },
    "targets_objects": {
      "type": "boolean"
    },
    "ignites_objects": {
      "type": "boolean"
    },
    "area_radius": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "cone_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "end_on_target_damage": {
      "type": "boolean"
    },
    "end_on_any_damage": {
      "type": "boolean"
    },
    "end_on_party_damage": {
      "type": "boolean"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "material": {
      "type": "string"
    },
    "material_component_item_id": {
      "type": "string"
    },
    "material_component_cost": {},
    "material_component_consumed": {
      "type": "boolean"
    },
    "consumed_material_item_id": {
      "type": "string"
    },
    "ritual": {
      "type": "boolean"
    },
    "rules_source": {
      "type": "string"
    },
    "rules_status": {
      "type": "string"
    },
    "school": {
      "type": "string"
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "string"
    },
    "trigger": {
      "const": ""
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/step"
      }
    }
  },
  "patternProperties": {
    "^_": {}
  },
  "additionalProperties": false,
  "definitions": {
    "damage_scale_by_outcome": {
      "oneOf": [
        { "type": "object", "required": ["hit", "miss"], "properties": { "hit": { "type": "number", "minimum": 0, "maximum": 1 }, "miss": { "type": "number", "minimum": 0, "maximum": 1 } }, "additionalProperties": false },
        { "type": "object", "required": ["success", "failure"], "properties": { "success": { "type": "number", "minimum": 0, "maximum": 1 }, "failure": { "type": "number", "minimum": 0, "maximum": 1 } }, "additionalProperties": false }
      ]
    },
    "rider_by_outcome": {
      "oneOf": [
        { "type": "object", "required": ["hit", "miss"], "properties": { "hit": { "type": "boolean" }, "miss": { "type": "boolean" } }, "additionalProperties": false },
        { "type": "object", "required": ["success", "failure"], "properties": { "success": { "type": "boolean" }, "failure": { "type": "boolean" } }, "additionalProperties": false }
      ]
    },
    "formula": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        {
          "type": "string",
          "pattern": "^([0-9]{1,3}|[1-9][0-9]?d(4|6|8|10|12|20))([+][0-9]{1,3})?$"
        }
      ]
    },
    "result_selector": {
      "type": "object",
      "required": ["step", "target", "measure"],
      "properties": {
        "step": { "type": "string", "minLength": 1 },
        "target": { "enum": ["same", "cast_target"] },
        "component": { "type": "string", "minLength": 1 },
        "component_id": { "type": "string", "minLength": 1 },
        "measure": { "enum": ["raw", "resolved", "hp_loss", "prevented", "absorbed", "healed", "margin", "hp_after"] }
      },
      "allOf": [
        {
          "if": { "properties": { "measure": { "enum": ["healed", "margin", "hp_after"] } }, "required": ["measure"] },
          "then": { "not": { "anyOf": [{ "required": ["component"] }, { "required": ["component_id"] }] } },
          "else": { "required": ["component"] }
        }
      ],
      "additionalProperties": false
    },
    "result_sum_selector": {
      "type": "object",
      "description": "One typed damage component and one measure summed once per actual target in a named earlier damage step.",
      "required": ["step", "component", "measure"],
      "properties": {
        "step": { "type": "string", "minLength": 1 },
        "component": { "type": "string", "minLength": 1 },
        "measure": { "enum": ["raw", "resolved", "hp_loss"] }
      },
      "additionalProperties": false
    },
    "breakpoint_row": {
      "type": "object",
      "required": ["threshold", "value"],
      "properties": {
        "threshold": { "type": "integer", "minimum": -999, "maximum": 999 },
        "value": { "type": "integer", "minimum": 0, "maximum": 999 }
      },
      "additionalProperties": false
    },
    "deterministic_formula_expression": {
      "description": "Existing deterministic shared formulas accepted as breakpoint input. String leaves are bounded integer constants with optional constant addition; dice strings are excluded.",
      "anyOf": [
        { "type": "integer", "minimum": 0, "maximum": 999 },
        { "type": "string", "pattern": "^[0-9]{1,3}(\\+[0-9]{1,3})?$" },
        { "type": "object", "required": ["caster_level"], "properties": { "caster_level": { "const": true } }, "additionalProperties": false },
        { "type": "object", "required": ["caster_class_level"], "properties": { "caster_class_level": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
        { "type": "object", "required": ["caster_proficiency_bonus"], "properties": { "caster_proficiency_bonus": { "const": true } }, "additionalProperties": false },
        { "type": "object", "required": ["caster_ability_modifier"], "properties": { "caster_ability_modifier": { "enum": ["STR", "DEX", "CON", "INT", "WIS", "CHA"] } }, "additionalProperties": false },
        { "type": "object", "required": ["selected_slot_level"], "properties": { "selected_slot_level": { "const": true } }, "additionalProperties": false },
        { "type": "object", "required": ["result"], "properties": { "result": { "$ref": "#/definitions/result_selector" } }, "additionalProperties": false },
        { "type": "object", "required": ["result_sum"], "properties": { "result_sum": { "$ref": "#/definitions/result_sum_selector" } }, "additionalProperties": false },
        { "$ref": "#/definitions/breakpoint_lookup_expression" },
        {
          "type": "object",
          "required": ["op", "left", "right"],
          "properties": {
            "op": { "enum": ["add", "subtract", "multiply", "floor_divide", "min", "max"] },
            "left": { "$ref": "#/definitions/deterministic_formula_expression" },
            "right": { "$ref": "#/definitions/deterministic_formula_expression" }
          },
          "additionalProperties": false
        }
      ]
    },
    "breakpoint_lookup_expression": {
      "type": "object",
      "description": "Select the greatest strictly increasing integer threshold not above the deterministic input. Runtime limits tables to 1–20 rows and rejects unsorted or duplicate thresholds.",
      "required": ["op", "input", "breakpoints"],
      "properties": {
        "op": { "const": "breakpoint_lookup" },
        "input": { "$ref": "#/definitions/deterministic_formula_expression" },
        "breakpoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/definitions/breakpoint_row" }
        }
      },
      "additionalProperties": false
    },
    "formula_expression": {
      "anyOf": [
        { "$ref": "#/definitions/formula" },
        {
          "type": "object",
          "required": ["caster_level"],
          "properties": { "caster_level": { "const": true } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["caster_class_level"],
          "properties": { "caster_class_level": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["caster_proficiency_bonus"],
          "properties": { "caster_proficiency_bonus": { "const": true } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["caster_ability_modifier"],
          "properties": { "caster_ability_modifier": { "enum": ["STR", "DEX", "CON", "INT", "WIS", "CHA"] } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["selected_slot_level"],
          "properties": { "selected_slot_level": { "const": true } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["result"],
          "properties": { "result": { "$ref": "#/definitions/result_selector" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["result_sum"],
          "properties": { "result_sum": { "$ref": "#/definitions/result_sum_selector" } },
          "additionalProperties": false
        },
        { "$ref": "#/definitions/breakpoint_lookup_expression" },
        {
          "type": "object",
          "required": ["op", "left", "right"],
          "properties": {
            "op": { "enum": ["add", "subtract", "multiply", "floor_divide", "min", "max"] },
            "left": { "$ref": "#/definitions/formula_expression" },
            "right": { "$ref": "#/definitions/formula_expression" }
          },
          "additionalProperties": false
        }
      ]
    },
    "predicate": {
      "anyOf": [
        { "type": "object", "required": ["all"], "properties": { "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/predicate" } } }, "additionalProperties": false },
        { "type": "object", "required": ["any"], "properties": { "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/predicate" } } }, "additionalProperties": false },
        { "type": "object", "required": ["not"], "properties": { "not": { "$ref": "#/definitions/predicate" } }, "additionalProperties": false },
        { "type": "object", "required": ["fact"], "properties": { "fact": { "enum": ["actor.id", "actor.level", "target.id", "target.current_hp", "target.max_hp", "target.is_alive", "target.is_wounded", "target.is_source_owner", "source.id", "source.owner_id", "action.id", "action.invocation_id", "item.definition_id", "item.instance_id", "spell.definition_id", "spell.invocation_id", "source.definition_id", "source.instance_id", "resolution.window", "resolution.occurrence_id", "resolution.kind", "resolution.actor_id", "resolution.target_id", "resolution.action_id", "resolution.action_invocation_id", "resolution.spell_definition_id", "resolution.spell_invocation_id", "resolution.source_definition_id", "resolution.source_instance_id", "resolution.source_owner_id", "resolution.roll_natural", "resolution.roll_modifier", "resolution.roll_total", "resolution.target_ac", "resolution.provisional_hit", "resolution.provisional_critical", "resolution.final_hit", "resolution.critical", "resolution.damage_occurrence_id", "resolution.damage_type", "resolution.damage_raw", "resolution.damage_resolved", "resolution.damage_hp_loss"] }, "eq": {}, "ne": {}, "lt": { "type": "number" }, "lte": { "type": "number" }, "gt": { "type": "number" }, "gte": { "type": "number" } }, "additionalProperties": false },
        { "type": "object", "required": ["result"], "properties": { "result": { "$ref": "#/definitions/result_selector" }, "eq": {}, "ne": {}, "lt": { "type": "number" }, "lte": { "type": "number" }, "gt": { "type": "number" }, "gte": { "type": "number" } }, "additionalProperties": false },
        { "type": "object", "required": ["result_sum"], "properties": { "result_sum": { "$ref": "#/definitions/result_sum_selector" }, "eq": {}, "ne": {}, "lt": { "type": "number" }, "lte": { "type": "number" }, "gt": { "type": "number" }, "gte": { "type": "number" } }, "additionalProperties": false }
      ]
    },
    "step": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["attack", "save", "damage", "effect"] },
        "gate": { "enum": ["always", "hit", "miss", "failed_save", "successful_save"] },
        "gate_step": {},
        "target": { "enum": ["target", "self", "area"] },
        "shape": { "enum": ["sphere", "cone", "cube"] },
        "radius": { "type": "integer", "minimum": 1, "maximum": 100 },
        "size": { "type": "integer", "minimum": 1, "maximum": 100 },
        "attack_type": { "enum": ["ranged_spell", "melee_spell"] },
        "damage": { "$ref": "#/definitions/formula" },
        "damage_type": { "enum": ["acid", "bludgeoning", "cold", "fire", "force", "lightning", "necrotic", "piercing", "poison", "psychic", "radiant", "slashing", "thunder"] },
        "component_id": { "type": "string", "minLength": 1 },
        "damage_components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["damage", "damage_type"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "damage": { "$ref": "#/definitions/formula" },
              "damage_type": { "enum": ["acid", "bludgeoning", "cold", "fire", "force", "lightning", "necrotic", "piercing", "poison", "psychic", "radiant", "slashing", "thunder"] },
              "upcast": {}
            },
            "additionalProperties": false
          }
        },
        "save": { "enum": ["STR", "DEX", "CON", "INT", "WIS", "CHA"] },
        "half_on_save": { "type": "boolean" },
        "damage_scale_by_outcome": { "$ref": "#/definitions/damage_scale_by_outcome" },
        "scaling": {},
        "upcast": {},
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "enum": ["heal", "temporary_hp", "grant_condition", "remove_condition", "area_selection"] },
              "value": { "$ref": "#/definitions/formula_expression" },
              "condition": { "type": "string" },
              "on_spell_hit": { "type": "boolean" },
              "on_failed_save": { "type": "boolean" },
              "rider_by_outcome": { "$ref": "#/definitions/rider_by_outcome" },
              "when": { "$ref": "#/definitions/predicate" },
              "ability_bonus_from_caster": { "type": "boolean" },
              "shape": { "enum": ["sphere", "cone", "cube"] },
              "radius": { "type": "integer", "minimum": 1, "maximum": 100 },
              "size": { "type": "integer", "minimum": 1, "maximum": 100 }
            },
            "additionalProperties": false
          }
        },
        "when": { "$ref": "#/definitions/predicate" }
      },
      "additionalProperties": false
    }
  }
}
