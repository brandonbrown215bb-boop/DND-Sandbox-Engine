{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shared spell",
  "description": "One ordinary spell record. Runtime SharedSpell.content_error also validates executable combinations, durations, gates and geometry.",
  "type": "object",
  "required": [
    "id",
    "name",
    "execution",
    "level",
    "range"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "execution": {
      "const": "shared"
    },
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9
    },
    "casting_time": {
      "enum": [
        "action",
        "bonus_action",
        "reaction"
      ]
    },
    "attack_unit_substitution": {
      "type": "object",
      "required": [
        "units"
      ],
      "properties": {
        "units": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        }
      },
      "additionalProperties": false
    },
    "range": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "range_kind": {
      "type": "string"
    },
    "range_by_character_level_feet": {},
    "target": {
      "enum": [
        "single",
        "self",
        "multi",
        "area",
        "cone"
      ]
    },
    "base_targets": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "attack_type": {
      "enum": [
        "none",
        "ranged_spell",
        "melee_spell"
      ]
    },
    "damage": {
      "$ref": "#/definitions/formula"
    },
    "damage_type": {
      "enum": [
        "acid",
        "bludgeoning",
        "cold",
        "fire",
        "force",
        "lightning",
        "necrotic",
        "piercing",
        "poison",
        "psychic",
        "radiant",
        "slashing",
        "thunder"
      ]
    },
    "scaling": {
      "type": "object",
      "patternProperties": {
        "^[0-9]+$": {
          "$ref": "#/definitions/formula"
        }
      },
      "additionalProperties": false
    },
    "upcast": {
      "type": "object",
      "properties": {
        "damage_per_level": {
          "type": "string",
          "pattern": "^[1-9][0-9]?d(4|6|8|10|12|20)$"
        },
        "healing_dice_per_level": {
          "type": "string",
          "pattern": "^[1-9][0-9]?d(4|6|8|10|12|20)$"
        },
        "starting_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "levels_per_increment": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "additional_targets_per_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "temporary_hp_per_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "healing_per_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "save": {
      "enum": [
        "STR",
        "DEX",
        "CON",
        "INT",
        "WIS",
        "CHA"
      ]
    },
    "half_on_save": {
      "type": "boolean"
    },
    "damage_scale_by_outcome": {
      "$ref": "#/definitions/damage_scale_by_outcome"
    },
    "requires_target_sight": {
      "type": "boolean"
    },
    "target_creature_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_creature_type_exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_sizes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ignore_cover_on_save": {
      "type": "boolean"
    },
    "effects": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "enum": [
                  "heal",
                  "temporary_hp"
                ]
              },
              "on_spell_hit": {
                "type": "boolean"
              },
              "on_failed_save": {
                "type": "boolean"
              },
              "rider_by_outcome": {
                "$ref": "#/definitions/rider_by_outcome"
              },
              "value": {
                "$ref": "#/definitions/formula"
              },
              "ability_bonus_from_caster": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "condition"
            ],
            "properties": {
              "type": {
                "enum": [
                  "grant_condition",
                  "remove_condition"
                ]
              },
              "on_spell_hit": {
                "type": "boolean"
              },
              "on_failed_save": {
                "type": "boolean"
              },
              "rider_by_outcome": {
                "$ref": "#/definitions/rider_by_outcome"
              },
              "condition": {
                "enum": [
                  "blinded",
                  "deafened",
                  "frightened",
                  "poisoned",
                  "prone",
                  "restrained",
                  "stunned",
                  "paralyzed",
                  "incapacitated",
                  "blessed",
                  "baned",
                  "shield_of_faith"
                ]
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "type",
              "shape"
            ],
            "properties": {
              "type": {
                "enum": [
                  "area_selection"
                ]
              },
              "on_spell_hit": {
                "type": "boolean"
              },
              "on_failed_save": {
                "type": "boolean"
              },
              "rider_by_outcome": {
                "$ref": "#/definitions/rider_by_outcome"
              },
              "shape": {
                "enum": [
                  "sphere",
                  "cone",
                  "cube"
                ]
              },
              "radius": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "size": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "concentration": {
      "type": "boolean"
    },
    "duration": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "repeat_save": {
      "enum": [
        "STR",
        "DEX",
        "CON",
        "INT",
        "WIS",
        "CHA"
      ]
    },
    "repeat_save_schedule": {
      "enum": [
        "target_turn_end",
        "elapsed_seconds"
      ]
    },
    "repeat_save_interval_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "repeat_save_stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "condition": {
            "type": "string",
            "enum": [
              "blinded",
              "deafened",
              "frightened",
              "poisoned",
              "prone",
              "restrained",
              "stunned",
              "paralyzed",
              "incapacitated",
              "blessed",
              "baned",
              "shield_of_faith"
            ]
          },
          "successes_required": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "minimum_margin": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "on_failure": {
            "enum": [
              "stay",
              "advance",
              "end"
            ]
          },
          "reset_successes_on_failure": {
            "type": "boolean"
          }
        },
        "required": [
          "condition",
          "successes_required"
        ],
        "additionalProperties": false
      }
    },
    "repeat_save_dc_progression": {
      "type": "object",
      "properties": {
        "increase_on": {
          "enum": [
            "attempt",
            "failure"
          ]
        },
        "amount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "maximum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "reset_on_success": {
          "type": "boolean"
        }
      },
      "required": [
        "increase_on",
        "amount",
        "maximum",
        "reset_on_success"
      ],
      "additionalProperties": false
    },
    "targets_objects": {
      "type": "boolean"
    },
    "ignites_objects": {
      "type": "boolean"
    },
    "area_radius": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "cone_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "end_on_target_damage": {
      "type": "boolean"
    },
    "end_on_any_damage": {
      "type": "boolean"
    },
    "end_on_party_damage": {
      "type": "boolean"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "material": {
      "type": "string"
    },
    "material_component_item_id": {
      "type": "string"
    },
    "material_component_cost": {},
    "material_component_consumed": {
      "type": "boolean"
    },
    "consumed_material_item_id": {
      "type": "string"
    },
    "ritual": {
      "type": "boolean"
    },
    "rules_source": {
      "type": "string"
    },
    "rules_status": {
      "type": "string"
    },
    "school": {
      "type": "string"
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "string"
    },
    "trigger": {
      "const": ""
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/step"
      }
    },
    "interruption_policy": {
      "type": "string",
      "enum": [
        "refund",
        "commit"
      ]
    },
    "failure_policy": {
      "type": "string",
      "enum": [
        "refund",
        "commit"
      ]
    },
    "empty_effect_policy": {
      "type": "string",
      "enum": [
        "commit",
        "refund"
      ]
    },
    "cast_settlement": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "commit",
            "refund"
          ]
        },
        {
          "type": "object",
          "properties": {
            "on_success": {
              "$ref": "#/definitions/cast_settlement_branch"
            },
            "on_failure": {
              "$ref": "#/definitions/cast_settlement_branch"
            },
            "on_interrupted": {
              "$ref": "#/definitions/cast_settlement_branch"
            },
            "on_negated": {
              "$ref": "#/definitions/cast_settlement_branch"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "cancellation_rule": {
      "type": "object",
      "required": [
        "target_scope"
      ],
      "properties": {
        "target_scope": {
          "enum": [
            "whole_cast"
          ]
        },
        "min_spell_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "max_spell_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "spell_levels": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          }
        },
        "schools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "spell_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contest": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "save",
                "check",
                "none"
              ]
            },
            "ability": {
              "enum": [
                "STR",
                "DEX",
                "CON",
                "INT",
                "WIS",
                "CHA"
              ]
            },
            "dc": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "dc_from": {
              "enum": [
                "stopping_caster",
                "target_caster"
              ]
            }
          },
          "additionalProperties": false
        },
        "stopping_cost_policy": {
          "$ref": "#/definitions/stopping_cost_policy"
        }
      },
      "additionalProperties": false
    },
    "stopping_cost_policy": {
      "$ref": "#/definitions/stopping_cost_policy"
    },
    "incoming_negation_rule": {
      "$ref": "#/definitions/incoming_negation_rule"
    },
    "physical_requirements": {
      "$ref": "#/definitions/physical_requirements"
    },
    "spatial_requirements": {
      "$ref": "#/definitions/spatial_requirements"
    }
  },
  "patternProperties": {
    "^_": {}
  },
  "additionalProperties": false,
  "definitions": {
    "damage_scale_by_outcome": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "hit",
            "miss"
          ],
          "properties": {
            "hit": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "miss": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "success",
            "failure"
          ],
          "properties": {
            "success": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "failure": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "rider_by_outcome": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "hit",
            "miss"
          ],
          "properties": {
            "hit": {
              "type": "boolean"
            },
            "miss": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "success",
            "failure"
          ],
          "properties": {
            "success": {
              "type": "boolean"
            },
            "failure": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "formula": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        {
          "type": "string",
          "pattern": "^([0-9]{1,3}|[1-9][0-9]?d(4|6|8|10|12|20))([+][0-9]{1,3})?$"
        }
      ]
    },
    "result_selector": {
      "type": "object",
      "required": [
        "step",
        "target",
        "measure"
      ],
      "properties": {
        "step": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "enum": [
            "same",
            "cast_target"
          ]
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "component_id": {
          "type": "string",
          "minLength": 1
        },
        "measure": {
          "enum": [
            "raw",
            "resolved",
            "hp_loss",
            "prevented",
            "absorbed",
            "healed",
            "margin",
            "hp_after"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "measure": {
                "enum": [
                  "healed",
                  "margin",
                  "hp_after"
                ]
              }
            },
            "required": [
              "measure"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "component"
                  ]
                },
                {
                  "required": [
                    "component_id"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "component"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "result_sum_selector": {
      "type": "object",
      "description": "One typed damage component and one measure summed once per actual target in a named earlier damage step.",
      "required": [
        "step",
        "component",
        "measure"
      ],
      "properties": {
        "step": {
          "type": "string",
          "minLength": 1
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "measure": {
          "enum": [
            "raw",
            "resolved",
            "hp_loss"
          ]
        }
      },
      "additionalProperties": false
    },
    "breakpoint_row": {
      "type": "object",
      "required": [
        "threshold",
        "value"
      ],
      "properties": {
        "threshold": {
          "type": "integer",
          "minimum": -999,
          "maximum": 999
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        }
      },
      "additionalProperties": false
    },
    "deterministic_formula_expression": {
      "description": "Existing deterministic shared formulas accepted as breakpoint input. String leaves are bounded integer constants with optional constant addition; dice strings are excluded.",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        {
          "type": "string",
          "pattern": "^[0-9]{1,3}(\\+[0-9]{1,3})?$"
        },
        {
          "type": "object",
          "required": [
            "caster_level"
          ],
          "properties": {
            "caster_level": {
              "const": true
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "caster_class_level"
          ],
          "properties": {
            "caster_class_level": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "caster_proficiency_bonus"
          ],
          "properties": {
            "caster_proficiency_bonus": {
              "const": true
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "caster_ability_modifier"
          ],
          "properties": {
            "caster_ability_modifier": {
              "enum": [
                "STR",
                "DEX",
                "CON",
                "INT",
                "WIS",
                "CHA"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "selected_slot_level"
          ],
          "properties": {
            "selected_slot_level": {
              "const": true
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "result"
          ],
          "properties": {
            "result": {
              "$ref": "#/definitions/result_selector"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "result_sum"
          ],
          "properties": {
            "result_sum": {
              "$ref": "#/definitions/result_sum_selector"
            }
          },
          "additionalProperties": false
        },
        {
          "$ref": "#/definitions/breakpoint_lookup_expression"
        },
        {
          "type": "object",
          "required": [
            "op",
            "left",
            "right"
          ],
          "properties": {
            "op": {
              "enum": [
                "add",
                "subtract",
                "multiply",
                "floor_divide",
                "min",
                "max"
              ]
            },
            "left": {
              "$ref": "#/definitions/deterministic_formula_expression"
            },
            "right": {
              "$ref": "#/definitions/deterministic_formula_expression"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "breakpoint_lookup_expression": {
      "type": "object",
      "description": "Select the greatest strictly increasing integer threshold not above the deterministic input. Runtime limits tables to 1\u201320 rows and rejects unsorted or duplicate thresholds.",
      "required": [
        "op",
        "input",
        "breakpoints"
      ],
      "properties": {
        "op": {
          "const": "breakpoint_lookup"
        },
        "input": {
          "$ref": "#/definitions/deterministic_formula_expression"
        },
        "breakpoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/definitions/breakpoint_row"
          }
        }
      },
      "additionalProperties": false
    },
    "formula_expression": {
      "anyOf": [
        {
          "$ref": "#/definitions/formula"
        },
        {
          "type": "object",
          "required": [
            "caster_level"
          ],
          "properties": {
            "caster_level": {
              "const": true
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "caster_class_level"
          ],
          "properties": {
            "caster_class_level": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "caster_proficiency_bonus"
          ],
          "properties": {
            "caster_proficiency_bonus": {
              "const": true
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "caster_ability_modifier"
          ],
          "properties": {
            "caster_ability_modifier": {
              "enum": [
                "STR",
                "DEX",
                "CON",
                "INT",
                "WIS",
                "CHA"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "selected_slot_level"
          ],
          "properties": {
            "selected_slot_level": {
              "const": true
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "result"
          ],
          "properties": {
            "result": {
              "$ref": "#/definitions/result_selector"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "result_sum"
          ],
          "properties": {
            "result_sum": {
