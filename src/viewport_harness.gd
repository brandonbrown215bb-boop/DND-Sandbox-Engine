	var owner := _fresh_char("Malformed Map Sorcerer", "human", "sorcerer", {"STR": 10, "DEX": 10, "CON": 12, "INT": 10, "WIS": 10, "CHA": 16})
	owner.character_id = "fixture:malformed_outcome_owner"
