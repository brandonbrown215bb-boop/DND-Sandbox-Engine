  "authored_intent": "Seen Humanoid WIS save or Paralyzed; repeat at each target turn end; higher slots add recipients.",
  "rules": [
    {
      "id": "r001",
      "text": "Choose a Humanoid that you can see within range."
    },
    {
      "id": "r002",
      "text": "The target must succeed on a Wisdom saving throw or have the Paralyzed condition for the duration."
    },
    {
      "id": "r003",
      "text": "At the end of each of its turns, the target repeats the save, ending the spell on itself on a success."
    },
    {
      "id": "r004",
      "text": "Using a Higher-Level Spell Slot."
    },
    {
      "id": "r005",
      "text": "You can target one additional Humanoid for each spell slot level above 2."
    }
  ],
