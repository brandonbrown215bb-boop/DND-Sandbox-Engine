  "authored_intent": "Touch creature; CON save for half 2d10 Necrotic; higher slots add 1d10; no obsolete melee attack.",
  "rules": [
    {
      "id": "r001",
      "text": "A creature you touch makes a Constitution saving throw, taking 2d10 Necrotic damage on a failed save or half as much damage on a successful one."
    },
    {
      "id": "r002",
      "text": "Using a Higher-Level Spell Slot."
    },
    {
      "id": "r003",
      "text": "The damage increases by 1d10 for each spell slot level above 1."
    }
  ],
