	var growth_ok: bool = grown_pool.get("success", false) and int(grown_pool.get("pool", {}).get("capacity", 0)) == 3 and int(grown_pool.get("pool", {}).get("current", -1)) == int(saved_pool_before_capacity["current"])
	owner.proficiency_bonus = 1
