	var sanctuary_attacker := _character("effects-sanctuary-attacker")
	sanctuary_attacker.ability_scores.set_score("WIS", 3)
	var blocked_sanctuary_attack := CombatAction.resolve_weapon_attack(sanctuary_attacker, sanctuary_target, {"id": "unarmed_strike", "type": "weapon", "ability": "STR", "damage": "1", "damage_type": "bludgeoning", "range": 1})
