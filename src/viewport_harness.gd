	var wrong_cause_class: Dictionary = DataLoader.classes.get("fixture:recipient_map_renamed_class", {})
	var wrong_cause_feature: Dictionary = wrong_cause_class.get("features_by_level", {}).get("1", [{}, {}])[1].duplicate(true)
