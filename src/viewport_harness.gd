func _seed_d8_then_d20(wanted: int) -> bool:
	for candidate in 100000:
		seed(candidate)
		randi_range(1, 8) # The selected weapon deals one d8 before Extra Attack.
		if randi_range(1, 20) == wanted:
			seed(candidate)
			return true
	return false


